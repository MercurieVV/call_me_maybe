#!/usr/bin/env bash
# Global launcher: runs the bridge for the current directory (or $SCALA_REPL_ROOT).
# Override SCALA_REPL_SCALA_VERSION / SCALA_REPL_CORE_VERSION for the target project.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT="$(cd "${SCALA_REPL_ROOT:-$PWD}" && pwd)"
export SCALA_REPL_SKILL_DIR="$SKILL_DIR"

usage() {
  cat <<'EOF'
Usage: scala_repl_add start|status|stop
       scala_repl_add usages|symbols|search '<regex>' [limit]
       scala_repl_add index [<repo-dir>] [--force]
       scala_repl_add [eval] <Scala code>
       scala_repl_add run <Scala code>    (stateless, no bridge; os-lib available)
       scala_repl_add <<'SCALA'
       <multiline Scala code>
       SCALA
EOF
}

reject_text_scan() {
  local code="$1"
  [[ "$code" =~ (semanticIndex|findSymbols|usagesOf|text-scan-ok) ]] && return 0
  if [[ "$code" =~ (\.scala|\"scala\"|\.sbt) ]] \
    || { [[ "$code" =~ os\.proc ]] && [[ "$code" =~ (\"grep\"|\"rg\"|\"find\"|\"ag\") ]]; }; then
    {
      echo "scala_repl_add: text scan of Scala sources rejected."
      echo "Use usagesOf(\"Name\") / findSymbols(\"regex\") / semanticIndex, or the one-liners: scala_repl_add usages|symbols|search '<regex>'."
      echo "For repos without SemanticDB run: scala_repl_add index <repo-dir>  (compiles it with SemanticDB, ~5 min; 'scala_repl_add index' lists repo roots)."
      echo "Only for non-Scala files add the comment // text-scan-ok to the code and retry."
    } >&2
    exit 3
  fi
}

print_api() {
  cat "$SKILL_DIR/repl-api.txt"
  echo
  scala-cli run -q --suppress-outdated-dependency-warning --suppress-experimental-feature-warning \
    "$SKILL_DIR/mcp-tools.sc" -- "$ROOT" 2>/dev/null || echo "(tool catalog unavailable: scalasemantic-mcp not runnable)"
}

index_repo() {
  local dir="$1" force="$2" n
  n="$(find "$dir" -name '*.semanticdb' -not -path '*/.git/*' 2>/dev/null | head -1)"
  if [[ -n "$n" && "$force" != force ]]; then echo "indexed (use --force to rebuild): $dir"; return 0; fi
  if [[ ! -f "$dir/build.sbt" ]]; then echo "skip (not an sbt build; compile it with SemanticDB manually): $dir"; return 0; fi
  echo "indexing $dir (sbt Test/compile with SemanticDB; several minutes, log: $dir/target/semanticdb-index.log)"
  mkdir -p "$dir/target"
  if (cd "$dir" && sbt -batch 'set ThisBuild / semanticdbEnabled := true' Test/compile > target/semanticdb-index.log 2>&1); then
    echo "done: $dir"
  else
    echo "FAILED (see log): $dir"; tail -15 "$dir/target/semanticdb-index.log"; return 1
  fi
}

ensure_bridge() {
  if ! scala-cli run -q "$SKILL_DIR/repl-bridge.scala" -- --root "$ROOT" status >/dev/null 2>&1; then
    echo "(starting REPL bridge, first call loads the index...)" >&2
    scala-cli run -q "$SKILL_DIR/repl-bridge.scala" -- --root "$ROOT" start >/dev/null 2>&1 || { echo "bridge failed to start; try: scala_repl_add start" >&2; exit 1; }
  fi
}

case "${1:-}" in
  usages|symbols|search)
    cmd="$1"; shift
    if [[ $# -lt 1 ]]; then usage >&2; exit 2; fi
    pattern="$1"; limit="${2:-}"
    ensure_bridge
    case "$cmd" in
      usages)  code="println(cmdUsages(\"\"\"$pattern\"\"\", ${limit:-50}))" ;;
      symbols) code="println(cmdSymbols(\"\"\"$pattern\"\"\", ${limit:-50}))" ;;
      search)  code="println(cmdSearch(\"\"\"$pattern\"\"\", ${limit:-60}))" ;;
    esac
    exec scala-cli run -q "$SKILL_DIR/repl-bridge.scala" -- --root "$ROOT" eval "$code"
    ;;
  index)
    shift
    force=""; targets=()
    for a in "$@"; do if [[ "$a" == --force ]]; then force=force; else targets+=("$a"); fi; done
    if [[ ${#targets[@]} -eq 0 ]]; then
      echo "Repo roots under $ROOT (build file, SemanticDB files). Index one with: scala_repl_add index <dir>"
      for d in "$ROOT" "$ROOT"/*/; do
        d="${d%/}"
        [[ -f "$d/build.sbt" || -f "$d/build.sc" || -f "$d/build.mill" || -f "$d/project.scala" ]] || continue
        echo "  $d  files=$(find "$d" -name '*.semanticdb' -not -path '*/.git/*' 2>/dev/null | wc -l)"
      done
      exit 0
    fi
    rc=0
    for t in "${targets[@]}"; do
      d="$(cd "$t" && pwd)"
      while [[ "$d" != / && ! -f "$d/build.sbt" && ! -f "$d/build.sc" && ! -f "$d/build.mill" ]]; do d="$(dirname "$d")"; done
      index_repo "$d" "$force" || rc=1
    done
    exit $rc
    ;;
  -h|--help|help)
    print_api
    usage
    exit 0
    ;;
  run)
    shift
    if [[ $# -eq 0 ]]; then
      if [[ -t 0 ]]; then
        usage >&2
        exit 2
      fi
      code="$(cat)"
    else
      code="$*"
    fi
    reject_text_scan "$code"
    cd "$ROOT"
    script="$(mktemp --suffix=.sc)"
    trap 'rm -f "$script"' EXIT
    {
      echo "//> using scala ${SCALA_REPL_SCALA_VERSION:-3.8.4}"
      echo "//> using dep com.lihaoyi::os-lib:0.11.5"
      echo "//> using dep io.github.mercurievv::scalasemantic-core:${SCALA_REPL_CORE_VERSION:-0.9.1}"
      grep -v '^println(' "$SKILL_DIR/repl-init.scala"
      printf '%s\n' "$code"
    } > "$script"
    scala-cli run -q --suppress-outdated-dependency-warning --suppress-experimental-feature-warning "$script"
    exit $?
    ;;
  start|status|stop)
    action="$1"
    shift
    if [[ $# -ne 0 ]]; then
      usage >&2
      exit 2
    fi
    if [[ "$action" == start ]]; then print_api; echo; fi
    exec scala-cli run "$SKILL_DIR/repl-bridge.scala" -- --root "$ROOT" "$action"
    ;;
  eval)
    shift
    ;;
esac

if [[ $# -eq 0 ]]; then
  if [[ -t 0 ]]; then
    usage >&2
    exit 2
  fi
  code="$(cat)"
else
  code="$*"
fi

if [[ -z "$code" ]]; then
  usage >&2
  exit 2
fi

reject_text_scan "$code"
exec scala-cli run "$SKILL_DIR/repl-bridge.scala" -- --root "$ROOT" eval "$code"
